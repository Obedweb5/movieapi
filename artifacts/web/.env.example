# Base URL of the deployed API server (your VPS), including the /api prefix.
# Used both server-side (SSR/RSC) and client-side (browser -> VPS directly).
NEXT_PUBLIC_API_URL=https://movieapi.obedtech.name.ng/api

# Clerk keys — must be the SAME Clerk instance the API server uses, since the
# frontend gets a session token from Clerk and sends it to the API as a
# Bearer token (see src/components/providers.tsx).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
